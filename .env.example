# QuadProxy customer proxy settings
# Copy values into your shell environment before running proxy-mode diagnostics.

# QuadProxy v1.0 supports authenticated HTTP proxies. Leave this as http.
PROXY_SCHEME=http
PROXY_HOST=proxy.example.net
PROXY_PORT=8080
PROXY_USER=your_username
PROXY_PASSWORD=your_password

# Legacy fallback supported if PROXY_PASSWORD is not set:
# WEBSHARE_PROXY_PASSWORD=your_password
